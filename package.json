{
    "name": "known-unknowns",
    "version": "0.1.0",
    "description": "Stops LLM agents from silently guessing what they don't know",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "test": "tsc && test -d dist/__tests__ && node --test dist/__tests__/*.test.js",
        "prepublishOnly": "npm run build && npm test"
    },
    "keywords": [
        "llm",
        "ai-agents",
        "uncertainty",
        "confidence",
        "structured-output",
        "selective-prediction",
        "hallucination",
        "claude",
        "anthropic"
    ],
    "author": "Bowo Adejuyigbe",
    "license": "MIT",
    "peerDependencies": {
        "@anthropic-ai/sdk": "^0.30.0"
    },
    "peerDependenciesMeta": {
        "@anthropic-ai/sdk": {
            "optional": true
        }
    },
    "devDependencies": {
        "typescript": "^5.5.0",
        "@types/node": "^20.0.0"
    },
    "files": [
        "dist",
        "!dist/__tests__"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/bowoadej/known-unknowns.git"
    }
}