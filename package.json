{
    "name": "known-unknowns",
    "version": "0.1.1",
    "description": "Stops LLM agents from silently guessing what they don't know",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "bin": {
        "known-unknowns-mcp": "./dist/mcpServer.js"
    },
    "scripts": {
        "build": "tsc",
        "test": "tsx --test src/__tests__/**/*.test.ts",
        "mcp": "tsx src/mcpServer.ts",
        "test:mcp": "tsx scripts/test-mcp-client.ts",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "llm",
        "ai-agents",
        "uncertainty",
        "confidence",
        "structured-output",
        "selective-prediction",
        "hallucination",
        "claude",
        "anthropic",
        "mcp",
        "model-context-protocol",
        "crewai",
        "langchain"
    ],
    "author": "Bowo Adejuyigbe",
    "license": "MIT",
    "dependencies": {
        "@anthropic-ai/sdk": "^0.30.0",
        "@modelcontextprotocol/sdk": "^1.0.0",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "typescript": "^5.5.0",
        "@types/node": "^20.0.0",
        "tsx": "^4.19.0"
    },
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/bowoadej/known-unknowns.git"
    }
}